---
version: 2.0.2
title: choice with two items
file: ./test/neotoma/passes/generate_abstract_test.gleam
test_name: generate_abstract_two_item_choice_test
---
[
  Case(
    Variable("Input"),
    [
      CaseClause(
        BinaryPattern([
          BinaryStringField("neotoma"),
          BinaryVariable(
            "_Remainder2",
            [Bytes],
          ),
        ]),
        [
          Match(
            VariablePattern("_Position2"),
            Apply(
              LocalFunction("advance_position___"),
              [
                Binary([
                  BinaryStringField("neotoma"),
                ]),
                Variable("Position"),
              ],
            ),
          ),
          Tuple([
            Atom("ok"),
            Tuple([
              Binary([
                BinaryStringField("neotoma"),
              ]),
              Variable("_Remainder2"),
              Variable("_Position2"),
            ]),
          ]),
        ],
      ),
      CaseClause(
        Ignore,
        [
          Case(
            Variable("Input"),
            [
              CaseClause(
                BinaryPattern([
                  BinaryStringField("rocks"),
                  BinaryVariable(
                    "_Remainder2",
                    [Bytes],
                  ),
                ]),
                [
                  Match(
                    VariablePattern("_Position2"),
                    Apply(
                      LocalFunction("advance_position___"),
                      [
                        Binary([
                          BinaryStringField("rocks"),
                        ]),
                        Variable("Position"),
                      ],
                    ),
                  ),
                  Tuple([
                    Atom("ok"),
                    Tuple([
                      Binary([
                        BinaryStringField("rocks"),
                      ]),
                      Variable("_Remainder2"),
                      Variable("_Position2"),
                    ]),
                  ]),
                ],
              ),
              CaseClause(
                Ignore,
                [
                  Tuple([
                    Atom("error"),
                    Atom("no_match"),
                  ]),
                ],
              ),
            ],
          ),
        ],
      ),
    ],
  ),
]
