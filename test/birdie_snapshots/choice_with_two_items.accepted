file: ./test/neotoma/passes/generate_abstract_test.gleam
test_name: generate_abstract_two_item_choice_test
---
[
  Case(
    Variable("Input"),
    [
      CaseClause(
        BinaryPattern([
          BinaryStringField("neotoma"),
          BinaryVariable(
            "Remainder2",
            [Bytes],
          ),
        ]),
        [
          Tuple([
            Atom("ok"),
            Tuple([
              Binary([
                BinaryStringField("neotoma"),
              ]),
              Variable("Remainder2"),
            ]),
          ]),
        ],
      ),
      CaseClause(
        Ignore,
        [
          Case(
            Variable("Input"),
            [
              CaseClause(
                BinaryPattern([
                  BinaryStringField("rocks"),
                  BinaryVariable(
                    "Remainder2",
                    [Bytes],
                  ),
                ]),
                [
                  Tuple([
                    Atom("ok"),
                    Tuple([
                      Binary([
                        BinaryStringField("rocks"),
                      ]),
                      Variable("Remainder2"),
                    ]),
                  ]),
                ],
              ),
              CaseClause(
                Ignore,
                [
                  Tuple([
                    Atom("error"),
                    Atom("no_match"),
                  ]),
                ],
              ),
            ],
          ),
        ],
      ),
    ],
  ),
]
