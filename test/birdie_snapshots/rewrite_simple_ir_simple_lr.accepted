---
version: 2.0.2
title: rewrite_simple_ir_simple_lr
---
Grammar(
  "rewrite_simple_ir_simple_lr",
  [
    Definition(
      "expression",
      Choice([
        Sequence(
          [
            Primary(Labeled(
              Primary(Atomic(Nonterminal("number"))),
              "LRHead",
            )),
            Primary(Labeled(
              Primary(Atomic(Nonterminal("expression_tail"))),
              "LRTail",
            )),
          ],
          Some(Generated(Cons(
            Variable("LRHead"),
            Variable("LRTail"),
          ))),
        ),
      ]),
    ),
    Definition(
      "expression_tail",
      Choice([
        Sequence(
          [
            Primary(Atomic(Terminal(String("+")))),
            Primary(Atomic(Nonterminal("number"))),
            Primary(Atomic(Nonterminal("expression_tail"))),
          ],
          None,
        ),
        Sequence(
          [
            Primary(Atomic(Terminal(String("-")))),
            Primary(Atomic(Nonterminal("number"))),
            Primary(Atomic(Nonterminal("expression_tail"))),
          ],
          None,
        ),
        Primary(Atomic(Epsilon)),
      ]),
    ),
    Definition(
      "number",
      Primary(Atomic(Terminal(CharacterClass([
        CharacterRange("0", "9"),
      ])))),
    ),
  ],
  None,
)
