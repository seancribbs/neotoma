                BinaryStringField("neotoma"),
              ]),
              Variable("Remainder2"),
            ]),
          ]),
        ],
      ),
      CaseClause(
        Ignore,
        [
          Tuple([
            Atom("error"),
            Atom("no_match"),
          ]),
        ],
      ),
    ],
  ),
]
