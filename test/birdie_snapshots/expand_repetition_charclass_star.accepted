---
version: 2.0.2
title: expand_repetition_charclass_star
---
Grammar(
  "expand_repetition_charclass_star",
  [
    Definition(
      "root",
      Primary(Atomic(Nonterminal("a_to_z@_star"))),
    ),
    Definition(
      "a_to_z@_star",
      Choice([
        Sequence(
          [
            Primary(Labeled(
              Primary(Atomic(Terminal(CharacterClass([
                CharacterRange("a", "z"),
                SingleCharacter("@"),
              ])))),
              "Head",
            )),
            Primary(Labeled(
              Primary(Atomic(Nonterminal("a_to_z@_star"))),
              "Tail",
            )),
          ],
          Some(Generated(Cons(
            Variable("Head"),
            Variable("Tail"),
          ))),
        ),
        Sequence(
          [Primary(Atomic(Epsilon))],
          Some(Generated(ListExpr([]))),
        ),
      ]),
    ),
  ],
  None,
)
