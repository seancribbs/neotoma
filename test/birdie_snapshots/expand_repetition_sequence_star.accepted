---
version: 2.0.2
title: expand_repetition_sequence_star
---
Grammar(
  "expand_repetition_sequence_star",
  [
    Definition(
      "root",
      Primary(Atomic(Nonterminal("seq_a_dot_star"))),
    ),
    Definition(
      "seq_a_dot_star",
      Choice([
        Sequence([
          Sequence([
            Primary(Atomic(Terminal(String("a")))),
            Primary(Atomic(Terminal(Anything))),
          ]),
          Primary(Atomic(Nonterminal("seq_a_dot_star"))),
        ]),
        Primary(Atomic(Epsilon)),
      ]),
    ),
  ],
)
